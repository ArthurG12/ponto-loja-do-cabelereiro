# Frontend: variáveis VITE_ são públicas no build.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_SUA_CHAVE_PUBLICA_ANON_AQUI
VITE_REP_API_URL=https://SEU-BACKEND.example.com

# Backend: configure estas variáveis somente no ambiente privado do servidor. A anon key não é secreta,
# mas é usada pelo backend para validar o access token com Auth; nunca use a service_role no navegador.
SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_ANON_NO_SERVIDOR
# Nunca use o prefixo VITE_ para a chave service_role.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_CHAVE_SERVICE_ROLE_NO_SERVIDOR
REP_COLLECTOR_ID=tablet-loja-01
REP_COLLECTOR_TYPE=02
REP_ESTABLISHMENT_ID=UUID_DO_ESTABELECIMENTO
# Identificação para o cabeçalho AFD REP-P; não preencher até haver registro INPI/documentos oficiais.
REP_INPI_REGISTRATION=REGISTRO_INPI_17_DIGITOS
REP_DEVELOPER_ID_TYPE=2
REP_DEVELOPER_DOCUMENT=CPF_DO_DESENVOLVEDOR_11_DIGITOS
REP_ALLOWED_ORIGIN=https://arthurg12.github.io
HOST=0.0.0.0
PORT=5176

# Assinador CAdES privado: somente quando o serviço Java estiver implementado e validado.
# Não habilita a rota AFD por si só; nunca coloque certificado, PFX/P12, PIN ou chave no .env do repositório.
REP_CADES_SIGNER_URL=https://ASSINADOR-PRIVADO.example.com
REP_CADES_SIGNER_TOKEN=TOKEN_SERVICO_A_SERVICO
REP_CADES_CERT_SHA256=FINGERPRINT_SHA256_DO_CERTIFICADO_64_HEX
